# URL base del sitio web (usada para sitemap y metadatos canónicos)
NEXT_PUBLIC_SITE_URL=https://estudiocontablealvarez.com

# URL del Backend de la aplicación
NEXT_PUBLIC_API_URL=https://api.estudiocontablealvarez.com/api

# Número de WhatsApp para botón flotante y CTA (formato internacional sin el símbolo +)
NEXT_PUBLIC_WHATSAPP=51923341098

# --- CONFIGURACIONES DE SEO Y ANALÍTICA (GOOGLE) ---
# ID de medición de Google Analytics 4 (ej. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Token de verificación de Google Search Console (elegir método de Verificación por Etiqueta HTML)
# ej: google-site-verification=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX (o solo el código XXXXXXX...)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
